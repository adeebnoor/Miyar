# Local development only. Generate real secrets; never commit them.
DATABASE_URL=sqlite:///./.runtime/miyar.db
MIYAR_ENV=development
MIYAR_JWT_SECRET=
MIYAR_SIGNING_KEY=
MIYAR_CORS_ORIGINS=https://adeebnoor.github.io
MIYAR_ENABLE_EMBEDDINGS=false
MIYAR_SERVE_UI=false
MIYAR_MODEL_CACHE=./.model-cache
# Per-organization HTTPS destinations; operator-controlled, never returned by the API.
MIYAR_WEBHOOKS_JSON={}
MIYAR_BOOTSTRAP_EMAIL=
MIYAR_BOOTSTRAP_PASSWORD=

# Optional organization-approved generation service; leave empty to keep local suggestions only.
MIYAR_KPI_ENDPOINT=
MIYAR_KPI_MODEL=
MIYAR_KPI_API_KEY=
